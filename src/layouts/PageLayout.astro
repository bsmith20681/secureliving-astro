---
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { makeIds, buildWebSite, buildPiece, assembleGraph } from '@jdevalk/seo-graph-core';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  openGraph?: {
    title?: string;
    description?: string;
    image?: string;
    type?: string;
  };
  graph?: Record<string, unknown> | null;
}

const { title, description, noindex, openGraph, graph: graphProp } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const siteUrl = 'https://secureliving.com';
const ids = makeIds({ siteUrl });
const orgId = ids.organization('secureliving');

const baseGraph = assembleGraph([
  buildPiece({
    '@type': 'Organization',
    '@id': orgId,
    name: 'Secure Living',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/cropped-favicon-sm-32x32.png`,
    },
  }),
  buildWebSite({ url: `${siteUrl}/`, name: 'Secure Living', publisher: { '@id': orgId } }, ids),
]);

const resolvedGraph = graphProp !== undefined ? graphProp : baseGraph;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/cropped-favicon-sm-32x32.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonical={canonicalURL.href}
      noindex={noindex ?? false}
      nofollow={noindex ?? false}
      ogType={openGraph?.type === 'article' ? 'article' : 'website'}
      ogImage={openGraph?.image}
      siteName="Secure Living"
      twitter={{ card: 'summary_large_image' }}
      graph={resolvedGraph}
    />
    <slot name="head" />
    <script is:inline type="text/javascript">
    (function(c, l, a, r, i, t, y) {
        c[a] = c[a] || function() {
            (c[a].q = c[a].q || []).push(arguments)
        };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "vpi5qr91pe");
</script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
