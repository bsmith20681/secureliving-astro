---
import PageLayout from './PageLayout.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ArticlePromoBox from '../components/companies/ArticlePromoBox.astro';
import { buildPiece, assembleGraph } from '@jdevalk/seo-graph-core';

interface Props {
  title: string;
  subtitle?: string;
  metaDescription?: string;
  category: string;
  categorySlug: string;
  author?: string;
  pubDate: Date;
  updatedDate?: Date;
  image?: ImageMetadata;
  company?: string;
  review?: boolean;
}

const {
  title,
  subtitle,
  metaDescription,
  category,
  categorySlug,
  author: authorSlug,
  pubDate,
  updatedDate,
  image,
  company: companySlug,
  review,
} = Astro.props;

const authorEntry = authorSlug ? await getEntry('authors', authorSlug) : null;
const authorName = authorEntry?.data.name;
const authorImage = authorEntry?.data.image;
const authorBio = authorEntry?.data.bio;

const companyEntry = companySlug ? await getEntry('companies', companySlug) : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = image ? new URL(image.src, Astro.site).href : null;

const articlePiece = buildPiece({
  '@type': 'Article',
  '@id': `${canonicalURL}#article`,
  headline: title,
  description: metaDescription,
  url: canonicalURL,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: authorName ?? 'Secure Living',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Secure Living',
  },
  ...(imageURL ? { image: imageURL } : {}),
  ...(category ? { articleSection: category } : {}),
});

const reviewPiece = (review && companyEntry) ? buildPiece({
  '@type': 'Review',
  '@id': `${canonicalURL}#review`,
  itemReviewed: {
    '@type': 'Product',
    name: companyEntry.data.name,
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: companyEntry.data.rating.overall,
    bestRating: 5,
  },
  author: {
    '@type': 'Person',
    name: authorName ?? 'Secure Living',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Secure Living',
  },
  datePublished: pubDate.toISOString(),
  url: canonicalURL,
}) : null;

const articleGraph = assembleGraph([
  articlePiece,
  ...(reviewPiece ? [reviewPiece] : []),
]);

const displayDate = (updatedDate || pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<PageLayout
  title={title}
  description={metaDescription}
  openGraph={{
    title,
    description: metaDescription,
    image: imageURL ?? undefined,
    type: 'article',
  }}
  graph={articleGraph}
>

  <article class="entry">
    <div class="entry-header">
      <div class="container">
        <div class="row">
          <div class={companyEntry ? 'col-xs-12 col-md-8' : 'col-xs-12 col-md-8 col-md-offset-2'}>
            <nav class="breadcrumb" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span class="breadcrumb__separator">&gt;&gt;</span>
              <a href={`/${categorySlug}`}>{category}</a>
              <span class="breadcrumb__separator">&gt;&gt;</span>
              <span class="breadcrumb__current">{title}</span>
            </nav>
            <h1 class="entry__title">{title}</h1>
            {subtitle && <p class="entry__subtitle">{subtitle}</p>}
            <div class="post-meta">
              <div class="post-meta__info">
                {authorName && (
                  <div class="post-meta__author">
                    {authorImage && (
                      <div class="post-meta__avatar">
                        <Image src={authorImage} alt={authorName} width={48} height={48} />
                      </div>
                    )}
                    <div class="post-meta__text">
                      <span class="post-meta__label">Written By</span>
                      <span class="post-meta__value">{authorName}</span>
                    </div>
                  </div>
                )}
                <div class="post-meta__date">
                  <span class="post-meta__label">Last Updated:</span>
                  <span class="post-meta__value">{displayDate}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="row article-row">
        <div class={companyEntry ? 'col-xs-12 col-md-8 article-content' : 'col-xs-12 col-md-8 col-md-offset-2 article-content'}>
            <div class="disclaimer">
              We might earn a commission based on product recommendations at no extra cost to you. <a class="link-muted" href="/affiliate-disclaimer/">Learn More</a>
            </div>
          <slot />

          {authorName && (
            <div class="author-bio">
              <h3 class="author-bio__heading">About the author</h3>
              <div class="author-bio__content">
                {authorImage && (
                  <div class="author-bio__avatar">
                    <Image src={authorImage} alt={authorName} width={80} height={80} />
                  </div>
                )}
                <div>
                  <p class="author-bio__name">{authorName}</p>
                  {authorBio && <p class="author-bio__description">{authorBio}</p>}
                </div>
              </div>
            </div>
          )}
        </div>

        {companyEntry && (
          <aside class="col-xs-12 col-md-4 article-sidebar">
            <ArticlePromoBox company={companyEntry.data} />
          </aside>
        )}
      </div>
    </div>
  </article>
</PageLayout>
